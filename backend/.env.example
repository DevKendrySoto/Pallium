# PostgreSQL 16
DATABASE_URL="postgresql://pallium:pallium@localhost:5432/pallium?schema=public"

# Redis (cache, sesiones, colas BullMQ)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Usuario administrador inicial (lo usa el seed)
ADMIN_EMAIL="admin@pallium.local"
ADMIN_PASSWORD="Admin12345"

# Almacenamiento de archivos (MinIO local / S3 prod)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="pallium"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
